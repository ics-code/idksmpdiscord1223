<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Weiterleitung …</title>
  <!-- Hauptweiterleitung via Meta-Refresh -->
  <meta http-equiv="refresh" content="0; URL='https://www.youtube.com/@FelixB_PL'">
  <script>
    // Fallback, falls Meta-Refresh nicht funktioniert
    window.onload = function() {
      window.location.href = "https://www.youtube.com/@FelixB_PL";
    };
  </script>
</head>
<body>
  <p>Du wirst weitergeleitet … falls nicht, <a href="https://www.youtube.com/@FelixB_PL">klicke hier</a>.</p>
</body>
</html>
